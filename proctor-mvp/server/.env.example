# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/proctor-mvp
# For Docker Compose: mongodb://mongo:27017/proctor-mvp
MONGODB_URI=mongodb://localhost:27017/proctor-mvp

# JWT Secret (change this in production!)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Client Build Path (for production)
CLIENT_BUILD_PATH=../client/dist/proctor-mvp
